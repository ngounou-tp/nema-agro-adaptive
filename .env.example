# Copy to .env and fill. NEVER commit .env (it is in .gitignore).
ADAPTION_API_KEY=pt_live_xxx          # Adaption dashboard -> API keys
HF_TOKEN=hf_xxx                        # huggingface.co -> Settings -> Access Tokens (Write)
KAGGLE_USERNAME=your_kaggle_username   # kaggle.com -> Settings -> API -> Create New Token (kaggle.json)
KAGGLE_KEY=xxx
